---
import { Icon } from "astro-icon/components";
import Comment from "@components/comment/index.astro";
import I18nKey from "../../i18n/i18nKey";
import { PageHeader } from "@components/features/page-header";
import { ShareCard } from "@components/features/posts/";
import { ProjectWarning } from "@components/features/projects";
import { projectsData } from "../../data/projects";
import { PublishedDate } from "@components/features/posts/atoms";
import { i18n } from "../../i18n/translation";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
const title = i18n(I18nKey.projectSuccubus),
      subtitle = i18n(I18nKey.projectSuccubusSubtitle),
	  dt = new Date("2024-11-11"),
	  sbs = projectsData[0];
const a = {
	"title":sbs.title,
	"description":sbs.description,
	"pubdate":sbs.startDate,
	"url":"https://prev.southcat.cc/projects/succubus/",
	"sitetitle":"Southcatsm's blogs",
	"avatar":"https://cdn-docs.southcat.cc/profile.png",
	"coverimage":sbs.image
}
const requiredname = i18n(I18nKey.projectNameRequired),
	  timeout = i18n(I18nKey.projectNetTimeout),
	  sch = i18n(I18nKey.projectSearch),
	  sching = i18n(I18nKey.projectSearching),
	  countss = i18n(I18nKey.projectUcounts),
	  exp7day = i18n(I18nKey.projectUexp7days);
---
<MainGridLayout title={title} description={subtitle}>
	<script>
		import("../../scripts/right-sidebar-layout.js");
	</script>
	<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
	
    <div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
        
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<div
				class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation"
			>
				<a
						href="/projects/"
						class="inline-flex items-center gap-1.5 text-sm text-white/90 hover:text-white bg-black/30 hover:bg-black/50 backdrop-blur-sm px-3 py-1.5 rounded-lg transition-colors"
					>
						<Icon
							name="material-symbols:arrow-back"
							class="text-base"
						/>
						{i18n(I18nKey.projectBackTo)}
				</a>
				<div class="flex flex-row items-center">
					<PublishedDate date={dt} />
				</div>
			</div>
			<PageHeader title={title} subtitle={subtitle} />
            
            <div class="w-full">
				<div class="relative flex items-center gap-2">
					<div class="relative flex-1">
						<input
							type="text"
							id="sctxt"
							placeholder={i18n(I18nKey.projectEnterName)}
							class="w-full px-4 py-2 pl-10 rounded-lg bg-[var(--btn-regular-bg)]
								text-black/90 dark:text-white/90
								border border-black/10 dark:border-white/10
								focus:outline-none focus:ring-2 focus:ring-[var(--primary)]/50
								transition-all duration-200"
						/>
						<svg
							class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-black/40 dark:text-white/40"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
						>
							<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
							></path>
						</svg>
					</div>
					<button class="btn-regular px-8 py-2 rounded-lg inline-flex items-center gap-3" id="scbtn">
						<label id="scbtnt">{i18n(I18nKey.projectSearch)}</label>
					</button>
				</div>
			</div>
			<br />
			<div id="archives" class="hidden max-w-3xl mx-auto p-6">
				<table class="w-full border-2 border-pink-300 dark:border-pink-700 rounded-2xl overflow-hidden shadow-lg shadow-pink-200/50 dark:shadow-pink-900/30 transition-all duration-300 bg-white/70 dark:bg-gray-800/70 backdrop-blur-md">
					<thead class="bg-gradient-to-r from-pink-400 to-purple-400 dark:from-pink-600 dark:to-purple-700 transition-all duration-300">
						<tr>
							<th colspan="3" class="px-6 py-4 text-2xl font-bold text-white drop-shadow-md transition-colors duration-300">
								{i18n(I18nKey.projectSuccubusReceiveArchvie)}
							</th>
						</tr>
					</thead>
					<tbody class="font-bold text-sm">
						<tr class="divide-x divide-pink-100 dark:divide-pink-800">
							<td class="px-4 py-3 text-pink-600 dark:text-pink-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUname)}：</span>
								<span class="truncate max-w-[120px] inline-block" id="tname"></span>
							</td>
							<td class="px-4 py-3 text-purple-600 dark:text-purple-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUgender)}：</span><label id="tgender"></label>
							</td>
							<td class="px-4 py-3 text-blue-500 dark:text-blue-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUcategory)}：</span><label id="tcategory"></label>
							</td>
						</tr>
						<tr class="divide-x divide-pink-100 dark:divide-pink-800 border-t border-pink-100 dark:border-pink-800">
							<td class="px-4 py-3 text-green-600 dark:text-green-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUheight)}：</span><label id="theight"></label>
							</td>
							<td class="px-4 py-3 text-yellow-600 dark:text-yellow-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUweight)}：</span><label id="tweight"></label>
							</td>
							<td class="px-4 py-3 text-red-500 dark:text-red-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUmeasurements)}：</span><label id="tmeasurements"></label>
							</td>
						</tr>
						<tr class="divide-x divide-pink-100 dark:divide-pink-800 border-t border-pink-100 dark:border-pink-800">
							<td class="px-4 py-3 text-orange-600 dark:text-orange-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUcup)}：</span><label id="tcup"></label> Cup
							</td>
							<td class="px-4 py-3 text-amber-700 dark:text-amber-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUhaircolor)}：</span><label id="thair"></label>
							</td>
							<td class="px-4 py-3 text-emerald-600 dark:text-emerald-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUpupil)}：</span><label id="tpupil"></label>
							</td>
						</tr>
						<tr class="divide-x divide-pink-100 dark:divide-pink-800 border-t border-pink-100 dark:border-pink-800">
							<td class="px-4 py-3 text-slate-700 dark:text-slate-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUhabitat)}：</span><label id="thabitat"></label>
							</td>
							<td class="px-4 py-3 text-teal-600 dark:text-teal-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUoutput)}：</span><label id="toutput"></label>
							</td>
							<td class="px-4 py-3 text-fuchsia-600 dark:text-fuchsia-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUdesirevalue)}：</span><label id="tdesire"></label>
							</td>
						</tr>
						<tr class="divide-x divide-pink-100 dark:divide-pink-800 border-t border-pink-100 dark:border-pink-800">
							<td class="px-4 py-3 text-rose-600 dark:text-rose-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUsensitivepos)}：</span><label id="tpos"></label>
							</td>
							<td class="px-4 py-3 text-indigo-600 dark:text-indigo-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUsextattoo)}：</span><label id="tline"></label>
							</td>
							<td class="px-4 py-3 text-cyan-600 dark:text-cyan-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUclimaxpct)}：</span><label id="tclimax"></label>
							</td>
						</tr>
						<tr class="divide-x divide-pink-100 dark:divide-pink-800 border-t border-pink-100 dark:border-pink-800">
							<td class="px-4 py-3 text-orange-600 dark:text-orange-400 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUsexhobby)}：</span><label id="thobby"></label>
							</td>
							<td class="px-4 py-3 text-violet-600 dark:text-violet-400 break-words max-w-[200px] bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUsexability)}：</span><label id="tability"></label>
							</td>
							<td class="px-4 py-3 text-rose-500 dark:text-rose-300 bg-white/50 dark:bg-gray-900/30">
								<span class="text-gray-400 dark:text-gray-500">{i18n(I18nKey.projectUrating)}：</span><label id="trating"></label>
							</td>
						</tr>
						<tr class="divide-x divide-pink-100 dark:divide-pink-800 border-t border-pink-100 dark:border-pink-800">
							<td class="px-4 py-3 bg-white/50 dark:bg-gray-900/30" colspan="3">
								<div class="flex gap-4 justify-center">
									<span class="text-red-500 dark:text-red-400">
										<span class="text-gray-400 dark:text-gray-500">S：</span><label id="tS"></label>%
									</span>
									<span class="text-blue-500 dark:text-blue-400">
										<span class="text-gray-400 dark:text-gray-500">M：</span><label id="tM"></label>%
									</span>
								</div>
							</td>
						</tr>
					</tbody>
				</table>
				<div class="mt-6 max-w-3xl mx-auto border-2 border-pink-300 dark:border-pink-700 rounded-2xl overflow-hidden shadow-lg shadow-pink-200/50 dark:shadow-pink-900/30">
					<div class="bg-gradient-to-r from-pink-400 to-purple-400 dark:from-pink-600 dark:to-purple-700 px-6 py-3">
						<h3 id="exptitle" class="text-white font-bold text-center drop-shadow-md"></h3>
					</div>
					<div class="bg-white/60 dark:bg-gray-800/60 backdrop-blur-md p-4">
						<canvas id="expchart" class="w-full h-64"></canvas>
					</div>
				</div>
			</div>
			<ShareCard
                title={a.title}
                pubDate={a.pubdate}
                url={a.url}
                description={a.description}
                avatar={a.avatar}
                coverImage={a.coverimage}
                siteTitle={a.sitetitle}
			>
		    </ShareCard>
			<ProjectWarning />
		</div>
	</div>

    <div class="mt-4">
		<Comment path="/projects/succubus/" />
	</div>

</MainGridLayout>

<script define:vars={{ requiredname, timeout, sch, sching, countss, exp7day }}>
	function uuid4() {
		let d = new Date().getTime(), d2 = performance.now() || 0;
		return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
			let r = Math.random() * 16;
			if (d > 0) {
				r = (d + r) % 16 | 0;
				d = Math.floor(d / 16);
			} else {
				r = (d2 + r) % 16 | 0;
				d2 = Math.floor(d2 / 16);
			}
			return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);
		}); 
	}

	let chartInstance = null;

	function fill0(num) {
		return num < 10 ? '0' + num : '' + num;
	}

	function renderChart(exp7days, name) {
		const canvas = document.getElementById('expchart'),
			  etitle = document.getElementById('exptitle'),
			  ctx = canvas.getContext('2d');;
		if (!canvas || !etitle || !ctx) return;

		if (chartInstance) {
			chartInstance.destroy();
			chartInstance = null;
		}

		const sorted = [...exp7days].sort((a, b) => new Date(a.date) - new Date(b.date));
		const labels = sorted.map(item => {
			const d = new Date(item.date);
			return fill0(d.getMonth() + 1) + '/' + fill0(d.getDate());
		});
		const data = sorted.map(item => item.count),
			  year = sorted.length > 0 ? new Date(sorted[0].date).getFullYear() : '';

		etitle.textContent = name + exp7day + "(" + year + ")";

		chartInstance = new Chart(ctx, {
			type: 'line',
			data: {
				labels: labels,
				datasets: [{
					label: countss,
					data: data,
					borderColor: '#f472b6',
					backgroundColor: 'rgba(244, 114, 182, 0.1)',
					borderWidth: 2.5,
					pointBackgroundColor: '#ec4899',
					pointBorderColor: '#ffffff',
					pointBorderWidth: 2,
					pointRadius: 5,
					pointHoverRadius: 7,
					tension: 0.3,
					fill: true
				}]
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				plugins: {
					legend: {
						display: false
					},
					tooltip: {
						callbacks: {
							title: function(a) {
								const idx = a[0].dataIndex;
								return sorted[idx] ? sorted[idx].date : '';
							},
							label: function(a) {
								return `${countss}: ${a.parsed.y}`;
							}
						}
					}
				},
				scales: {
					x: {
						ticks: { color: '#9ca3af', font: { size: 11 } },
						grid: { color: 'rgba(156, 163, 175, 0.1)' }
					},
					y: {
						ticks: { color: '#9ca3af', font: { size: 11 } },
						grid: { color: 'rgba(156, 163, 175, 0.1)' },
						beginAtZero: false
					}
				}
			}
		});
	}

	function show(){
		const input = document.getElementById("sctxt"),
			  archive = document.getElementById("archives"),
			  btn = document.getElementById("scbtn"),
			  btntxt = document.getElementById("scbtnt"),
			  name = input.value.trim();
		if (!input || !archive || !btn || !btntxt) return;
		if (name.length === 0) {
			const placeholder = input.placeholder;
			input.placeholder = requiredname;
			input.classList.add("ring-2", "ring-red-400/50");
			setTimeout(() => {
				input.placeholder = placeholder;
				input.classList.remove("ring-2", "ring-red-400/50");
			}, 2000);
			archive.classList.add("hidden");
			return;
		}

		btntxt.textContent = sching;
		btn.disabled = true;

		const api = `https://api.southcat.cc/v2-succubus?uuid=${uuid4()}&name=${encodeURIComponent(name)}`;
		fetch(api)
			.then((response) => {
				if (!response.ok) {
					throw new Error("Network response was not ok");
				}
				return response.json();
			})
			.then((data) => {
				const tname = document.getElementById("tname"),
					tgender = document.getElementById("tgender"),
					tcategory = document.getElementById("tcategory"),
					theight = document.getElementById("theight"),
					tweight = document.getElementById("tweight"),
					tmeasurements = document.getElementById("tmeasurements"),
					tcup = document.getElementById("tcup"),
					thair = document.getElementById("thair"),
					tpupil = document.getElementById("tpupil"),
					thabitat = document.getElementById("thabitat"),
					toutput = document.getElementById("toutput"),
					tdesire = document.getElementById("tdesire"),
					thobby = document.getElementById("thobby"),
					tability = document.getElementById("tability"),
					trating = document.getElementById("trating"),
					tpos = document.getElementById("tpos"),
					tline = document.getElementById("tline"),
					tclimax = document.getElementById("tclimax"),
					tS = document.getElementById("tS"),
					tM = document.getElementById("tM");

				const map1 = {
					'tname': 'name',
					'tgender': 'gender',
					'tcategory': 'category',
					'theight': 'height',
					'tweight': 'weight',
					'thair': 'hair',
					'tpupil': 'pupil',
					'thabitat': 'habitat',
					'toutput': 'output',
					'tdesire': 'desire',
					'thobby': 'hobby',
					'tability': 'ability',
					'trating': 'rating',
					'tpos': 'pos',
					'tline': 'line',
					'tclimax': 'climax'
				}, map2 = {
					tname, tgender, tcategory, theight, tweight, thair,
					tpupil, thabitat, toutput, tdesire, thobby, tability,
					trating, tpos, tline, tclimax
				};
				Object.keys(map1).forEach(key => {
					const el = map2[key], field = map1[key];
					el.textContent = data[field];
				});
				const m = data.measurements,
					  parts = [m.bust, m.waist, m.hips].filter(Boolean).join(" ");
				tmeasurements.textContent = parts;
				tcup.textContent = m.cup;
				tS.textContent = data.SM.S;
				tM.textContent = data.SM.M;
				archive.classList.remove("hidden");
				setTimeout(() => renderChart(data.exp7days, data.name || name), 100);
				btntxt.textContent = sch;
				btn.disabled = false;
				input.classList.add("ring-2", "ring-green-400/50");
				setTimeout(() => {
					input.classList.remove("ring-2", "ring-green-400/50");
				}, 1500);
			})
			.catch(() => {
				archive.classList.add("hidden");
				btntxt.textContent = sch;
				btn.disabled = false;
				input.value = '';
				input.placeholder = timeout;
				input.classList.add("ring-2", "ring-yellow-400/50");
				setTimeout(() => {
					input.placeholder = "";
					input.classList.remove("ring-2", "ring-yellow-400/50");
				}, 3000);
			});
	}
	document.querySelector("#scbtn")?.addEventListener("click", show);
	document.getElementById('sctxt')?.addEventListener('keypress', function(e) {if (e.key === 'Enter') {show();}});
</script>